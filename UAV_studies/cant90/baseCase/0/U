FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (20 0 0);  

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"

    inlet
    {
        type            fixedValue;
        value           $internalField;
    }

    outlet
    {
        type            inletOutlet;  
        inletValue      uniform (0 0 0); 
        value           $internalField;
    }

    side
    {
		type            freestream;
        freestreamValue $internalField;
    }

    uav
    {
        type            noSlip;
    }
	
	symmetry
	{
		type            symmetryPlane;	
	}
}

